{
  "name": "moxiao-studio",
  "version": "0.2.0",
  "private": true,
  "license": "MPL-2.0",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --filter @moxiao/desktop dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "pnpm build && playwright test e2e/editorial-workflow.spec.ts --reporter=line",
    "validate:epub": "tsx scripts/validate-epub.mts",
    "test:package": "playwright test e2e/packaged-smoke.spec.ts --reporter=line",
    "audit:workspace": "tsx scripts/audit-legacy-workspace.mts",
    "audit:xianxinzimo": "tsx scripts/audit-xianxinzimo-source.mts",
    "pack:xianxinzimo": "tsx scripts/build-xianxinzimo-pack.mts",
    "dist:mac": "tsx scripts/release-mac.mts",
    "check": "pnpm typecheck && pnpm test && pnpm build"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/node": "^24.3.0",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "electron",
      "esbuild"
    ]
  }
}
