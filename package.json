{
  "name": "moxiao-studio",
  "version": "0.1.0",
  "private": true,
  "license": "UNLICENSED",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --filter @moxiao/desktop dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
