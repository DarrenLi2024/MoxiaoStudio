{
  "name": "@moxiao/desktop",
  "version": "0.1.2",
  "private": true,
  "license": "MPL-2.0",
  "description": "面向中文文学创作者与编校者的本地优先开放出版工作台",
  "author": "Moxiao Studio contributors",
  "type": "module",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "dist:mac:raw": "pnpm build && electron-builder --mac dmg --arm64 --publish never",
    "pack:mac": "pnpm build && electron-builder --mac dir --arm64 --publish never",
    "preview": "electron-vite preview",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@moxiao/domain": "workspace:*",
    "@moxiao/editorial": "workspace:*",
    "@moxiao/ontology": "workspace:*",
    "@moxiao/publication": "workspace:*",
    "@moxiao/storage": "workspace:*",
    "lucide-react": "^0.468.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "@vitejs/plugin-react": "^6.0.5",
    "electron": "43.4.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "vite": "^8.2.1"
  },
  "build": {
    "appId": "com.moxiaostudio.desktop",
    "productName": "墨校台文枢",
    "asar": true,
    "directories": {
      "output": "../../release",
      "buildResources": "../../build"
    },
    "files": [
      "out/**/*",
      "package.json"
    ],
    "extraResources": [
      { "from": "../../LICENSE", "to": "LICENSE" },
      { "from": "../../THIRD_PARTY_NOTICES.md", "to": "THIRD_PARTY_NOTICES.md" }
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "hardenedRuntime": true,
      "forceCodeSigning": true,
      "notarize": true,
      "minimumSystemVersion": "12.0",
      "target": ["dmg"]
    },
    "dmg": {
      "title": "墨校台文枢 ${version}",
      "contents": [
        { "x": 150, "y": 180, "type": "file" },
        { "x": 410, "y": 180, "type": "link", "path": "/Applications" }
      ]
    },
    "artifactName": "Moxiao-Studio-${version}-${arch}.${ext}"
  }
}
